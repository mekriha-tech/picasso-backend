PROJECT_NAME="Picasso API"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# Database Configuration 
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password_here
POSTGRES_DB=picasso_db

# Security
SECRET_KEY="generate_a_random_string_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Cloudflare R2 artwork image storage (optional; uploads return 503 until all are set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
